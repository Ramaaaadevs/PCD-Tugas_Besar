        <mxCell id="mnEAhFK4iUgRwLCRUVwS-1" edge="1" parent="_dqwYr6WYY_cfj2xDeQ--1" source="_dqwYr6WYY_cfj2xDeQ--12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.559;entryY=0.027;entryDx=0;entryDy=0;entryPerimeter=0;defaultLabelBackgroundColor=page;labelPadding=0 4;" target="_dqwYr6WYY_cfj2xDeQ--13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start([\&quot;Mulai\&quot;]) --&gt; Load[/\&quot;Input Dataset 50 Citra &amp; Ground Truth Mask\&quot;/]\n\n    subgraph Tahap0 [\&quot;0. Persiapan Data &amp; Parameter\&quot;]\n        Load --&gt; Split[\&quot;Pembagian Data Stratified 80:20 (40 Tuning Set : 10 Testing Set)\&quot;]\n        Split --&gt; InitParam[\&quot;Inisialisasi Grid Parameter (Toleransi Warna LAB/HSV &amp; Ambang Sobel)\&quot;]\n        InitParam --&gt; NextImg[\&quot;Ambil Citra dari Dataset\&quot;]\n        NextImg --&gt; Geo[\&quot;Operasi Geometri: Center-Crop 3:4 &amp; Resize (720 x 960 px)\&quot;]\n    end\n\n    subgraph Tahap1 [\&quot;1. Pra-pemrosesan (Image Enhancement)\&quot;]\n        Geo --&gt; CLAHE[\&quot;Perbaikan Kontras Lokal: Konversi LAB &amp; CLAHE pada Kanal L\&quot;]\n        CLAHE --&gt; GBlur[\&quot;Pelembutan Citra (Low-Pass Filter): Gaussian Smoothing 5x5\&quot;]\n    end\n\n    subgraph Tahap2 [\&quot;2. Segmentasi Hibrida (Warna &amp; Konvolusi Tepi)\&quot;]\n        GBlur --&gt; BranchWarna[\&quot;Transformasi Ruang Warna (LAB / HSV)\&quot;]\n        GBlur --&gt; BranchTepi[\&quot;Konversi Grayscale (Luminance Y)\&quot;]\n\n        BranchWarna --&gt; Patch[\&quot;Sampling Median Warna Latar (3 Patch Sisi Atas 30x30 px)\&quot;]\n        Patch --&gt; Thresh[\&quot;Pengambangan Warna (Color Thresholding) -&gt; Initial BG Mask\&quot;]\n\n        BranchTepi --&gt; Sobel[\&quot;Konvolusi Spasial Kernel Sobel 3x3 (Gx, Gy) &amp; Magnitude\&quot;]\n        Sobel --&gt; Barrier[\&quot;Thresholding Gradien &amp; Dilasi Tepi -&gt; Edge Barrier Mask\&quot;]\n\n        Thresh --&gt; LogicJoin[\&quot;Operasi Logika Boolean (BG AND NOT Barrier) &amp; Border-Connected Flood\&quot;]\n        Barrier --&gt; LogicJoin\n        LogicJoin --&gt; Invert[\&quot;Operasi Komplemen (Bitwise NOT) -&gt; Raw Foreground Mask\&quot;]\n    end\n\n    subgraph Tahap3 [\&quot;3. Pascapemrosesan (Morfologi &amp; Operasi Logika)\&quot;]\n        Invert --&gt; Morph[\&quot;Morfologi Closing &amp; Opening (Kernel Elips 7x7)\&quot;]\n        Morph --&gt; Largest[\&quot;Seleksi Komponen Terbesar (Aras Objek) &amp; Hole Filling (OR/AND/NOT)\&quot;]\n        Largest --&gt; Mask[/\&quot;Output 1: Binary Foreground Mask (0 / 255)\&quot;/]\n    end\n\n    subgraph Tahap4 [\&quot;4. Evaluasi, Tuning Parameter &amp; Komposisi Latar\&quot;]\n        Mask --&gt; HitungIoU[\&quot;Hitung Metrik IoU terhadap Ground Truth\&quot;]\n        HitungIoU --&gt; CekMode{\&quot;Fase Tuning atau Testing?\&quot;}\n\n        %% LOOPING 1: GRID SEARCH TUNING\n        CekMode -- \&quot;Fase Tuning (40 Citra)\&quot; --&gt; CekTuning{\&quot;Semua Kombinasi Parameter\\nSudah Diuji?\&quot;}\n        CekTuning -- \&quot;Sudah\&quot; --&gt; SimpanBest[\&quot;Simpan Parameter Terbaik (best_params.json)\&quot;]\n        SimpanBest --&gt; MasukTest[\&quot;Mulai Evaluasi pada Testing Set (10 Citra)\&quot;]\n\n        %% LOOPING 2: EVALUASI TEST SET &amp; KOMPOSISI LATAR\n        CekMode -- \&quot;Fase Testing (10 Citra)\&quot; --&gt; Feather[\&quot;Penghalusan Tepi (Gaussian Edge Feathering 9x9) -&gt; Alpha Matte\&quot;]\n        Feather --&gt; Blend[\&quot;Operasi Aritmetika Alpha Blending dengan Latar Baru (Merah / Biru)\&quot;]\n        Blend --&gt; CekTest{\&quot;Semua Citra Uji &amp; Skenario Ablasi\\nSelesai Diproses?\&quot;}\n    end\n\n    CekTuning -- \&quot;Belum (Loop Parameter Berikutnya)\&quot; --&gt; InitParam\n    MasukTest --&gt; NextImg\n    CekTest -- \&quot;Belum (Loop Citra Berikutnya)\&quot; --&gt; NextImg\n    CekTest -- \&quot;Sudah\&quot; --&gt; OutFinal[/\&quot;Output 2: Pasfoto Berlatar Baru &amp; Tabel Hasil Evaluasi IoU\&quot;/]\n    OutFinal --&gt; End([\&quot;Selesai\&quot;])&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="_dqwYr6WYY_cfj2xDeQ--141">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="4. Evaluasi, Tuning Parameter &amp; Komposisi Latar" mermaidId="n:Tahap4" mermaidBaseStyle="html=1;whiteSpace=nowrap;strokeWidth=1;verticalAlign=top;fillColor=#F0FDF4;strokeColor=#4ADE80;fontColor=#000000;fontFamily=Recursive;fontSize=14;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="4. Evaluasi, Tuning Parameter &amp; Komposisi Latar" id="_dqwYr6WYY_cfj2xDeQ--142">
